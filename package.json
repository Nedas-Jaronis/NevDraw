{
  "name": "realtime-wireframes",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter '@rtw/server' --filter '@rtw/web' dev",
    "build": "bun run --filter '@rtw/web' build",
    "start": "bun run --filter '@rtw/server' start",
    "test": "bun test",
    "typecheck": "tsc -p .",
    "check": "bun run typecheck && bun test",
    "probe": "bun --env-file=.env apps/server/scripts/probe.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
