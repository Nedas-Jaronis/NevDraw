# Live Wireframes environment. Copy to .env at the repo root and fill in what you have:
#   cp .env.example .env
#
# Every key is optional. Without keys the board still works: drafts come from the
# built-in keyword classifier and the LLM cleanup pass is switched off.
# All keys are read on the server only and never reach the browser.

# --- Server -------------------------------------------------------------------
# Port for `bun run start` (serves the web app and /ws). `bun dev` uses 3000 (Vite) + 3001 (server).
PORT=3000

# --- Jev (TypeSafe AI): instant per-keystroke drafts -----------------------------
# Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Pin the model version so answers don't change under you.
JEV_MODEL=jev-1.13.0

# --- LLM cleanup pass ------------------------------------------------------------
# Which provider refines drafts on pause / Enter: gemini | gptoss
# The other one (if its key is set) is used as the automatic fallback.
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# gpt-oss-120b through any OpenAI-compatible endpoint (e.g. Groq, Cerebras, OpenRouter, OpenAI)
GPTOSS_API_KEY=
GPTOSS_BASE_URL=https://api.groq.com/openai/v1
GPTOSS_MODEL=openai/gpt-oss-120b

# --- Tuning (optional) -------------------------------------------------------------
# One Jev attempt per piece; slower answers keep the keyword placeholder.
JEV_TIMEOUT_MS=2500
# Typing pause before the LLM cleanup pass runs.
LLM_DEBOUNCE_MS=1500
# How long Enter waits for the LLM's version before committing the instant one.
LLM_COMMIT_WAIT_MS=1200
# Upper bound for one LLM call.
LLM_TIMEOUT_MS=8000
